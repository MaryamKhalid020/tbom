<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_tbom_equipment_tree" model="ir.ui.view">
        <field name="name">tbom.equipment.list</field>
        <field name="model">tbom.equipment</field>
        <field name="arch" type="xml">
            <list string="Operation Equipment" editable="bottom">
                <field name="name"/>
                <field name="operation_id"/>
                <field name="employee_id" string="Assigned Custodian"/>
                <field name="deployment_date"/>
                <field name="return_date"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'planned'"
                       decoration-warning="status == 'deployed'"
                       decoration-success="status == 'returned'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tbom_equipment_form" model="ir.ui.view">
        <field name="name">tbom.equipment.form</field>
        <field name="model">tbom.equipment</field>
        <field name="arch" type="xml">
            <form string="Operation Equipment">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Projector Epson 3000"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Equipment Status">
                            <field name="operation_id" options="{'no_create': True}"/>
                            <field name="employee_id" string="Assigned Custodian"/>
                            <field name="status"/>
                        </group>
                        <group string="Dates">
                            <field name="deployment_date"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tbom_equipment_search" model="ir.ui.view">
        <field name="name">tbom.equipment.search</field>
        <field name="model">tbom.equipment</field>
        <field name="arch" type="xml">
            <search string="Search Equipment">
                <field name="name" string="Equipment Name"/>
                <field name="operation_id" string="Operation"/>
                <field name="employee_id" string="Custodian"/>
                <filter string="Planned" name="planned" domain="[('status', '=', 'planned')]"/>
                <filter string="Deployed" name="deployed" domain="[('status', '=', 'deployed')]"/>
                <filter string="Returned" name="returned" domain="[('status', '=', 'returned')]"/>
                <group>
                    <filter string="Operation" name="group_by_operation" context="{'group_by': 'operation_id'}"/>
                    <filter string="Custodian" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_tbom_equipment" model="ir.actions.act_window">
        <field name="name">Operation Equipment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tbom.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tbom_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register Operation Equipment
            </p>
            <p>
                Allocate specific physical equipment and assign custodians for temporary operations.
            </p>
        </field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_tbom_equipment_sub"
              name="Equipment"
              parent="menu_tbom_root"
              sequence="12"/>

    <menuitem id="menu_tbom_equipment"
              name="Operation Equipment"
              parent="menu_tbom_equipment_sub"
              action="action_tbom_equipment"
              sequence="10"/>

</odoo>
