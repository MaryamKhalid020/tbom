<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_tbom_state_history_tree" model="ir.ui.view">
        <field name="name">tbom.operation.state.history.list</field>
        <field name="model">tbom.operation.state.history</field>
        <field name="arch" type="xml">
            <list string="State Transitions"
                  create="false"
                  delete="false"
                  edit="false">
                <field name="transition_datetime"/>
                <field name="operation_id"/>
                <field name="previous_state" widget="badge"
                       decoration-info="previous_state == 'planned'"
                       decoration-warning="previous_state == 'setup' or previous_state == 'closing'"
                       decoration-success="previous_state == 'active'"
                       decoration-danger="previous_state == 'cancelled'"/>
                <field name="new_state" widget="badge"
                       decoration-info="new_state == 'planned'"
                       decoration-warning="new_state == 'setup' or new_state == 'closing'"
                       decoration-success="new_state == 'active'"
                       decoration-danger="new_state == 'cancelled'"/>
                <field name="user_id" string="Changed By"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tbom_state_history_form" model="ir.ui.view">
        <field name="name">tbom.operation.state.history.form</field>
        <field name="model">tbom.operation.state.history</field>
        <field name="arch" type="xml">
            <form string="State Transition"
                  create="false"
                  delete="false"
                  edit="false">
                <sheet>
                    <group>
                        <group string="Audit Information">
                            <field name="operation_id" readonly="1"/>
                            <field name="transition_datetime" readonly="1"/>
                            <field name="user_id" string="Changed By" readonly="1"/>
                        </group>
                        <group string="Transition Details">
                            <field name="previous_state" readonly="1"/>
                            <field name="new_state" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tbom_state_history_search" model="ir.ui.view">
        <field name="name">tbom.operation.state.history.search</field>
        <field name="model">tbom.operation.state.history</field>
        <field name="arch" type="xml">
            <search string="Search State History">
                <field name="operation_id" string="Operation"/>
                <field name="user_id" string="Changed By"/>
                <filter string="To Setup" name="to_setup" domain="[('new_state', '=', 'setup')]"/>
                <filter string="To Active" name="to_active" domain="[('new_state', '=', 'active')]"/>
                <filter string="To Closed" name="to_closed" domain="[('new_state', '=', 'closed')]"/>
                <filter string="To Cancelled" name="to_cancelled" domain="[('new_state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Operation" name="group_by_operation" context="{'group_by': 'operation_id'}"/>
                    <filter string="Changed By" name="group_by_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_tbom_state_history" model="ir.actions.act_window">
        <field name="name">State History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tbom.operation.state.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tbom_state_history_search"/>
        <field name="help" type="html">
            <p>
                There is no state transition history recorded yet.
            </p>
            <p>
                State history is logged automatically whenever a Temporary Operation changes lifecycle states.
            </p>
        </field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_tbom_state_history_sub"
              name="State History"
              parent="menu_tbom_root"
              sequence="16"/>

    <menuitem id="menu_tbom_state_history"
              name="State History Logs"
              parent="menu_tbom_state_history_sub"
              action="action_tbom_state_history"
              sequence="10"/>

</odoo>
