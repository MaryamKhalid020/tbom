<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         LIST VIEW — Temporary Operations
    =================================================================== -->
    <record id="view_temporary_operation_tree" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.list</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <list string="Temporary Operations"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'setup' or state == 'closing'"
                  decoration-info="state == 'planned'">
                <field name="code"/>
                <field name="name"/>
                <field name="location" optional="show"/>
                <field name="operation_type" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="responsible_id" optional="show" widget="many2one_avatar_user"/>
                <field name="budget" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'setup' or state == 'closing'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================
         FORM VIEW — Temporary Operation (Operations Control Center)
    =================================================================== -->
    <record id="view_temporary_operation_form" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.form</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <form string="Temporary Operation">

                <!-- ── WORKFLOW HEADER ─────────────────────────────────── -->
                <header>
                    <!-- Primary workflow action (only one visible at a time) -->
                    <button name="action_setup"
                            string="Start Setup"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'planned'"
                            groups="tbom.group_tbom_manager"/>
                    <button name="action_activate"
                            string="Start Operation"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'setup'"
                            groups="tbom.group_tbom_manager"/>
                    <button name="action_closing"
                            string="Start Closing"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'active'"
                            groups="tbom.group_tbom_manager"/>
                    <button name="action_close"
                            string="Close Operation"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'closing'"
                            groups="tbom.group_tbom_manager"
                            confirm="Are you sure you want to close this operation? Once closed, it cannot be edited."/>
                    <!-- Post-close action -->
                    <button name="%(tbom.action_report_temporary_operation)d"
                            string="Print Final Report"
                            type="action"
                            class="oe_highlight"
                            invisible="state != 'closed'"/>
                    <!-- Secondary (less prominent) -->
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('closed', 'cancelled')"
                            groups="tbom.group_tbom_manager"/>
                    <button name="action_draft"
                            string="Reset to Planned"
                            type="object"
                            invisible="state != 'cancelled'"
                            groups="tbom.group_tbom_manager"/>
                    <!-- Status bar — the lifecycle hero -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="planned,setup,active,closing,closed"
                           options="{'clickable': '1'}"/>
                </header>

                <!-- ── FORM SHEET ───────────────────────────────────────── -->
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_resources" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="resource_count" widget="statinfo" string="Resources"/>
                        </button>
                        <button name="action_view_equipment" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="equipment_count" widget="statinfo" string="Equipment"/>
                        </button>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="expense_count" widget="statinfo" string="Expenses"/>
                        </button>
                        <button name="action_view_employees" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                        <button name="action_view_state_history" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="state_history_count" widget="statinfo" string="State History"/>
                        </button>
                    </div>
                    <!-- Budget Alert Banners -->
                    <div class="alert alert-warning text-center" role="alert" invisible="budget_utilization &lt; 90 or budget_utilization &gt;= 100 or budget &lt;= 0">
                        <strong>Approaching Budget Limit:</strong> This operation has utilized <field name="budget_utilization" readonly="1" class="fw-bold"/>% of its allocated budget.
                    </div>
                    <div class="alert alert-danger text-center" role="alert" invisible="budget_utilization &lt; 100 or budget &lt;= 0">
                        <strong>Over Budget:</strong> This operation is over budget! Utilization is at <field name="budget_utilization" readonly="1" class="fw-bold"/>%.
                    </div>


                    <!-- Operation Identity Block -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Summer Promotional Exhibition"/>
                        </h1>
                        <div class="text-muted small">
                            <field name="code" placeholder="e.g. OP-2026-001"/>
                        </div>
                    </div>

                    <!-- Core Operation Fields -->
                    <group>
                        <group string="Operation Details">
                            <field name="operation_type"/>
                            <field name="location"
                                   placeholder="e.g. Hall A, Exhibition Center"/>
                            <field name="responsible_id"
                                   options="{'no_create': True}"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Schedule &amp; Budget">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="budget"/>
                        </group>
                    </group>

                    <!-- Operation Health & Risk Control Center -->
                    <group string="Operation Health &amp; Risk Control Center">
                        <group string="Timeline Details">
                            <field name="duration" string="Total Duration (Days)" readonly="1"/>
                            <field name="days_elapsed" string="Days Elapsed" readonly="1"/>
                            <field name="days_remaining" string="Days Remaining" readonly="1"/>
                            <field name="employee_count" string="Assigned Employees" readonly="1"/>
                        </group>
                        <group string="Resource utilization &amp; Financials">
                            <field name="resource_count" string="Total Resources" readonly="1"/>
                            <field name="deployed_resource_count" string="Deployed Resources" readonly="1"/>
                            <field name="equipment_count" string="Total Equipment" readonly="1"/>
                            <field name="deployed_equipment_count" string="Deployed Equipment" readonly="1"/>
                            <field name="total_expenses" string="Total Expenses" readonly="1"/>
                            <field name="remaining_budget" string="Remaining Budget" readonly="1"/>
                            <field name="budget_utilization" widget="progressbar" string="Budget Utilization" readonly="1"/>
                        </group>
                        <group string="Critical Attention &amp; Risk Levels">
                            <field name="risk_level" widget="badge" 
                                   decoration-success="risk_level == 'normal'" 
                                   decoration-warning="risk_level == 'warning'" 
                                   decoration-danger="risk_level == 'critical'"
                                   string="Risk Level" readonly="1"/>
                            <field name="is_overdue" string="Operation Overdue" readonly="1" invisible="not is_overdue" class="text-danger fw-bold"/>
                            <field name="is_ending_soon" string="Ending Soon" readonly="1" invisible="not is_ending_soon" class="text-warning fw-bold"/>
                            <field name="is_over_budget" string="Over Budget Warning" readonly="1" invisible="not is_over_budget" class="text-danger fw-bold"/>
                            <field name="is_near_budget" string="Near Budget Limit" readonly="1" invisible="not is_near_budget" class="text-warning fw-bold"/>
                            <field name="has_outstanding_resources_closing" string="Resources Outstanding in Closing" readonly="1" invisible="not has_outstanding_resources_closing" class="text-warning fw-bold"/>
                            <field name="has_outstanding_equipment_closing" string="Equipment Outstanding in Closing" readonly="1" invisible="not has_outstanding_equipment_closing" class="text-warning fw-bold"/>
                            <field name="missing_closing_info" string="Missing Required Closing Data" readonly="1" invisible="not missing_closing_info" class="text-danger fw-bold"/>
                        </group>
                    </group>

                    <!-- ── NOTEBOOK ─────────────────────────────────────── -->
                    <notebook>

                        <!-- EMPLOYEES TAB -->
                        <page string="Employees" name="employees_page">
                            <field name="employee_ids">
                                <list string="Assigned Employees">
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="department_id" optional="show"/>
                                    <field name="work_email" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- RESOURCES TAB -->
                        <page string="Resources" name="resources_page">
                            <field name="resource_ids">
                                <list string="Resources"
                                      editable="bottom"
                                      decoration-warning="status == 'deployed'"
                                      decoration-danger="status == 'damaged'"
                                      decoration-success="status == 'returned'">
                                    <field name="name"/>
                                    <field name="resource_type"/>
                                    <field name="quantity"/>
                                    <field name="assigned_employee_id" optional="show"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-info="status == 'planned'"
                                           decoration-warning="status == 'deployed'"
                                           decoration-success="status == 'returned'"
                                           decoration-danger="status == 'damaged'"/>
                                </list>
                            </field>
                        </page>

                        <!-- EQUIPMENT TAB -->
                        <page string="Equipment" name="equipment_page">
                            <field name="equipment_ids">
                                <list string="Equipment"
                                      editable="bottom"
                                      decoration-warning="status == 'deployed' and not return_date"
                                      decoration-success="status == 'returned'">
                                    <field name="name"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="deployment_date"/>
                                    <field name="return_date"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-info="status == 'planned'"
                                           decoration-warning="status == 'deployed'"
                                           decoration-success="status == 'returned'"/>
                                </list>
                            </field>
                        </page>

                        <!-- EXPENSES TAB -->
                        <page string="Expenses" name="expenses_page">
                            <field name="expense_ids">
                                <list string="Expenses" editable="bottom">
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="employee_id" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- DASHBOARD TAB -->
                        <page string="Dashboard" name="dashboard_page">
                            <!-- A. Operational Status -->
                            <group string="Operational Status">
                                <group>
                                    <field name="state"
                                           readonly="1"
                                           string="Current Status"
                                           widget="badge"
                                           decoration-info="state == 'planned'"
                                           decoration-warning="state == 'setup' or state == 'closing'"
                                           decoration-success="state == 'active'"
                                           decoration-danger="state == 'cancelled'"/>
                                    <field name="employee_count"
                                           readonly="1"
                                           string="Assigned Employees"/>
                                </group>
                            </group>

                            <!-- B. Resource Utilization -->
                            <group string="Resource Utilization">
                                <group string="Summary">
                                    <field name="resource_count"
                                           readonly="1"
                                           string="Total Resources"/>
                                </group>
                                <group string="Breakdown">
                                    <field name="planned_resource_count"
                                           readonly="1"
                                           string="Planned"/>
                                    <field name="deployed_resource_count"
                                           readonly="1"
                                           string="Deployed"/>
                                    <field name="returned_resource_count"
                                           readonly="1"
                                           string="Returned"/>
                                </group>
                            </group>

                            <!-- C. Financial Health -->
                            <group string="Financial Health">
                                <group>
                                    <field name="budget"
                                           readonly="1"
                                           string="Total Budget"/>
                                    <field name="total_expenses"
                                           readonly="1"
                                           string="Total Expenses"/>
                                </group>
                                <group>
                                    <field name="remaining_budget"
                                           readonly="1"
                                           string="Remaining Budget"/>
                                    <field name="budget_utilization"
                                           readonly="1"
                                           widget="progressbar"
                                           string="Budget Utilization (%)"/>
                                </group>
                            </group>
                        </page>

                        <!-- STATE HISTORY TAB -->
                        <page string="State History" name="history_page">
                            <field name="state_history_ids">
                                <list string="State Transitions"
                                      create="false"
                                      delete="false"
                                      edit="false">
                                    <field name="transition_datetime"
                                           string="Date &amp; Time"/>
                                    <field name="previous_state"
                                           string="From"
                                           widget="badge"
                                           decoration-info="previous_state == 'planned'"
                                           decoration-warning="previous_state == 'setup' or previous_state == 'closing'"
                                           decoration-success="previous_state == 'active'"
                                           decoration-danger="previous_state == 'cancelled'"/>
                                    <field name="new_state"
                                           string="To"
                                           widget="badge"
                                           decoration-info="new_state == 'planned'"
                                           decoration-warning="new_state == 'setup' or new_state == 'closing'"
                                           decoration-success="new_state == 'active'"
                                           decoration-danger="new_state == 'cancelled'"/>
                                    <field name="user_id" string="Changed By"/>
                                </list>
                            </field>
                        </page>

                        <!-- CLOSING CHECKLIST TAB -->
                        <page string="Closing Checklist" name="closing_checklist_page" invisible="state not in ('closing', 'closed')">
                            <group string="Ready for Closure Checklist">
                                <field name="checklist_resources_returned" widget="boolean" string="All Resources Returned" readonly="1"/>
                                <field name="checklist_equipment_returned" widget="boolean" string="All Equipment Returned" readonly="1"/>
                                <field name="checklist_expenses_recorded" widget="boolean" string="Expenses Recorded" readonly="1"/>
                                <field name="checklist_no_outstanding" widget="boolean" string="No Outstanding Operational Items" readonly="1"/>
                                <field name="checklist_dates_available" widget="boolean" string="Required Dates Available" readonly="1"/>
                                <field name="checklist_financials_ok" widget="boolean" string="Final Financials OK" readonly="1"/>
                                <field name="checklist_ready_for_close" widget="boolean" string="Operation Ready for Closure" readonly="1"/>
                            </group>
                            <div class="alert alert-info text-center" role="alert" invisible="checklist_ready_for_close">
                                <strong>Closure Pending:</strong> Please ensure all checklist items are ticked before closing the operation. Deployed resources and equipment must be returned, and start/end dates must be valid.
                            </div>
                            <div class="alert alert-success text-center" role="alert" invisible="not checklist_ready_for_close">
                                <strong>Ready to Close:</strong> All closure requirements are satisfied. The operation is ready to be closed.
                            </div>
                        </page>

                        <!-- DESCRIPTION TAB -->
                        <page string="Description" name="description_page">
                            <field name="description"
                                   placeholder="Describe the temporary operation details, objectives, scope, and any relevant operational notes..."
                                   nolabel="1"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         CALENDAR VIEW — Operation Planning
    =================================================================== -->
    <record id="view_temporary_operation_calendar" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.calendar</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <calendar string="Operation Planning" 
                      date_start="start_date" 
                      date_stop="end_date" 
                      color="state"
                      quick_create="false">
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ===================================================================
         GRAPH VIEW — Operations Analysis
    =================================================================== -->
    <record id="view_temporary_operation_graph" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.graph</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <graph string="Operations Analysis" type="bar" sample="1">
                <field name="state"/>
                <field name="budget" type="measure"/>
                <field name="total_expenses" type="measure"/>
                <field name="remaining_budget" type="measure"/>
                <field name="budget_utilization" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===================================================================
         PIVOT VIEW — Operations Analysis
    =================================================================== -->
    <record id="view_temporary_operation_pivot" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.pivot</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <pivot string="Operations Analysis" sample="1">
                <field name="state" type="row"/>
                <field name="operation_type" type="col"/>
                <field name="budget" type="measure"/>
                <field name="total_expenses" type="measure"/>
                <field name="remaining_budget" type="measure"/>
                <field name="budget_utilization" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================================
         SEARCH VIEW — Temporary Operations
    =================================================================== -->
    <record id="view_temporary_operation_search" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.search</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <search string="Search Operations">
                <!-- Search Fields -->
                <field name="name" string="Operation Name"/>
                <field name="code" string="Operation Code"/>
                <field name="location"/>
                <field name="responsible_id"/>

                <!-- State Filters -->
                <separator/>
                <filter string="Planned"   name="planned"   domain="[('state', '=', 'planned')]"/>
                <filter string="Setup"     name="setup"     domain="[('state', '=', 'setup')]"/>
                <filter string="Active"    name="active"    domain="[('state', '=', 'active')]"/>
                <filter string="Closing"   name="closing"   domain="[('state', '=', 'closing')]"/>
                <filter string="Closed"    name="closed"    domain="[('state', '=', 'closed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>

                <!-- Quick Filters -->
                <separator/>
                <filter string="My Operations"
                        name="my_operations"
                        domain="[('responsible_id', '=', uid)]"/>
                <filter string="Active Operations"
                        name="active_operations"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Operations in Closing"
                        name="closing_operations"
                        domain="[('state', '=', 'closing')]"/>
                <filter string="Over Budget"
                        name="over_budget"
                        domain="[('is_over_budget', '=', True)]"/>
                <filter string="Near Budget Limit"
                        name="near_budget"
                        domain="[('is_near_budget', '=', True)]"/>
                <filter string="Ending Soon"
                        name="ending_soon"
                        domain="[('is_ending_soon', '=', True)]"/>
                <filter string="Overdue Operations"
                        name="overdue_operations"
                        domain="[('is_overdue', '=', True)]"/>
                <filter string="With Outstanding Resources"
                        name="outstanding_resources"
                        domain="[('deployed_resource_count', '>', 0)]"/>
                <filter string="With Outstanding Equipment"
                        name="outstanding_equipment"
                        domain="[('deployed_equipment_count', '>', 0)]"/>

                <!-- Group By -->
                <group>
                    <filter string="Status"
                            name="group_by_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Operation Type"
                            name="group_by_type"
                            context="{'group_by': 'operation_type'}"/>
                    <filter string="Responsible Manager"
                            name="group_by_responsible"
                            context="{'group_by': 'responsible_id'}"/>
                    <filter string="Location"
                            name="group_by_location"
                            context="{'group_by': 'location'}"/>
                    <filter string="Company"
                            name="group_by_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         KANBAN VIEW — Operations Board
    =================================================================== -->
    <record id="view_temporary_operation_kanban" model="ir.ui.view">
        <field name="name">tbom.temporary.operation.kanban</field>
        <field name="model">tbom.temporary.operation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column"
                    records_draggable="false">
                <!-- Declare all fields used in the card template -->
                <field name="name"/>
                <field name="code"/>
                <field name="operation_type"/>
                <field name="location"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="responsible_id"/>
                <field name="budget"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">

                            <!-- Operation Name (prominent) -->
                            <div class="o_kanban_record_title fw-bold">
                                <field name="name"/>
                            </div>

                            <!-- Operation Code (muted identifier) -->
                            <div class="text-muted small mb4">
                                <field name="code"/>
                            </div>

                            <!-- Location -->
                            <div class="mt4">
                                <i class="fa fa-map-marker fa-fw text-muted"
                                   role="img" aria-label="Location"/>
                                <field name="location"/>
                            </div>

                            <!-- Operation Type -->
                            <div class="text-muted small">
                                <field name="operation_type"/>
                            </div>

                            <!-- Date Range -->
                            <div class="text-muted small mt4">
                                <i class="fa fa-calendar fa-fw"
                                   role="img" aria-label="Dates"/>
                                <field name="start_date"/> &#8211; <field name="end_date"/>
                            </div>

                            <!-- Card Footer: Budget + Responsible -->
                            <div class="o_kanban_record_bottom mt8">
                                <div class="oe_kanban_bottom_left fw-bold">
                                    <field name="budget"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_id"
                                           widget="many2one_avatar_user"/>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================================================================
         WINDOW ACTION
    =================================================================== -->
    <record id="action_temporary_operation" model="ir.actions.act_window">
        <field name="name">Temporary Operations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tbom.temporary.operation</field>
        <field name="view_mode">kanban,list,form,calendar,graph,pivot</field>
        <field name="search_view_id" ref="view_temporary_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Temporary Operation
            </p>
            <p>
                Define temporary, time- and location-bound business operations.
            </p>
        </field>
    </record>

    <!-- Background Activity Reminder Cron -->
    <record id="cron_tbom_operation_reminders" model="ir.cron">
        <field name="name">TBOM Operation Reminders Scheduler</field>
        <field name="model_id" ref="model_tbom_temporary_operation"/>
        <field name="state">code</field>
        <field name="code">model.cron_operation_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ===================================================================
         MENU STRUCTURE
    =================================================================== -->
    <menuitem id="menu_tbom_root"
              name="TBOM"
              sequence="10"/>

    <menuitem id="menu_temporary_operation_sub"
              name="Operations"
              parent="menu_tbom_root"
              sequence="5"/>

    <menuitem id="menu_temporary_operation"
              name="Temporary Operations"
              parent="menu_temporary_operation_sub"
              action="action_temporary_operation"
              sequence="10"/>

</odoo>
