<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_tbom_expense_tree" model="ir.ui.view">
        <field name="name">tbom.expense.list</field>
        <field name="model">tbom.expense</field>
        <field name="arch" type="xml">
            <list string="Expenses">
                <field name="date"/>
                <field name="description"/>
                <field name="amount" sum="Total Amount"/>
                <field name="employee_id"/>
                <field name="operation_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tbom_expense_form" model="ir.ui.view">
        <field name="name">tbom.expense.form</field>
        <field name="model">tbom.expense</field>
        <field name="arch" type="xml">
            <form string="Expense">
                <sheet>
                    <group>
                        <group string="Expense Details">
                            <field name="description" placeholder="e.g. Fuel for generator"/>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                        <group string="Relationships">
                            <field name="operation_id" options="{'no_create': True}"/>
                            <field name="employee_id" string="Paid By / Claimant"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tbom_expense_search" model="ir.ui.view">
        <field name="name">tbom.expense.search</field>
        <field name="model">tbom.expense</field>
        <field name="arch" type="xml">
            <search string="Search Expenses">
                <field name="description" string="Expense Description"/>
                <field name="operation_id" string="Operation"/>
                <field name="employee_id" string="Claimant"/>
                <group expand="0" string="Group By">
                    <filter string="Operation" name="group_by_operation" context="{'group_by': 'operation_id'}"/>
                    <filter string="Claimant" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_tbom_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tbom.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tbom_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new Expense
            </p>
            <p>
                Track budget spending and log individual operation expenses.
            </p>
        </field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_tbom_expense_sub"
              name="Expenses"
              parent="menu_tbom_root"
              sequence="14"/>

    <menuitem id="menu_tbom_expense"
              name="Expenses"
              parent="menu_tbom_expense_sub"
              action="action_tbom_expense"
              sequence="10"/>

</odoo>
