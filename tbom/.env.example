# Outgoing SMTP Mail Server settings for Odoo
# Note: Keep your active values in your Odoo configuration (.conf) or environment variables.
# Never commit your .env or actual passwords to Git.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_ENCRYPTION=starttls
